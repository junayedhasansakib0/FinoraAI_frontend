# Origin of the Finora API, including the version prefix.
#
# Every VITE_* variable is inlined into the browser bundle at build time, so this file may
# only ever hold public values. API keys and secrets belong in the server's environment.
#
# Development: keep the relative default so requests go through the Vite dev proxy, which
# forwards /api to http://localhost:5000 (same origin, so cookies behave as in production).
# Production: use the full API origin, e.g. https://finora-server.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1
